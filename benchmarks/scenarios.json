    {"id": "nightly-roads", "prompt": "Analyze a region's road graph every night", "workload": {"workflow": "scheduled", "area_km2": 80, "daily_runs": 1, "users": 1}, "expected": "local-pbf-extract"},
    {"id": "public-poi-explorer", "prompt": "Serve multiple interactive visitors querying POIs", "workload": {"workflow": "interactive", "area_km2": 50, "daily_runs": 100, "users": 100}, "expected": "local-database-or-managed-api"},
    {"id": "large-ad-hoc", "prompt": "Extract OSM features for a large region once", "workload": {"workflow": "one-off", "area_km2": 10000, "daily_runs": 1, "users": 1}, "expected": "local-pbf-extract"},
    {"id": "basemap-only", "prompt": "Render a static basemap for a regional atlas", "workload": {"workflow": "one-off", "area_km2": 200, "daily_runs": 1, "users": 1, "needs_basemap": true}, "expected": "policy-compatible-map-tiles"},
