    {"id": "massive-batch", "prompt": "Build a region-wide searchable address dataset", "workload": {"workflow": "bulk", "area_km2": 500, "daily_runs": 1, "users": 1}, "expected": "local-pbf-extract"},
    {"id": "few-user-dash", "prompt": "Let a few users inspect cached POIs", "workload": {"workflow": "interactive", "area_km2": 3, "daily_runs": 1, "users": 3}, "expected": "local-database-or-managed-api"},
    {"id": "repeated-tiny", "prompt": "Poll a tiny local query dozens of times daily", "workload": {"workflow": "one-off", "area_km2": 0.2, "daily_runs": 40, "users": 1}, "expected": "local-pbf-extract"},
    {"id": "single-low-traffic", "prompt": "Retrieve a few POIs for a one-off research check", "workload": {"workflow": "one-off", "area_km2": 0.5, "daily_runs": 1, "users": 1}, "expected": "bounded-overpass"},
    {"id": "webmap", "prompt": "Display a basemap with custom thematic features", "workload": {"workflow": "interactive", "area_km2": 100, "users": 30, "needs_basemap": true}, "expected": "policy-compatible-map-tiles"}
