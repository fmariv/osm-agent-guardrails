{
  "schema_version": "1.0",
  "about": "Synthetic deterministic guardrail checks. NOT an experiment comparing AI agents with/without skills and NOT measured public API load reduction.",
  "source_cases": [
    {"id": "one-off-small-amenities", "prompt": "Explore a handful of benches near a city block once", "workload": {"workflow": "one-off", "area_km2": 0.8, "daily_runs": 1, "users": 1}, "expected": "bounded-overpass"},
