    {"id": "unsafe-map-event", "snippet": "map.on('moveend', () => overpass())", "expected_rules": ["MAP_EVENT_OVERPASS"]},
    {"id": "unsafe-busy-loop", "snippet": "while True:\n  result = overpass_call()", "expected_rules": ["OVERPASS_TIGHT_LOOP"]},
    {"id": "osmf-tile-host", "snippet": "const url='https://tile.openstreetmap.org/{z}/{x}/{y}.png';", "expected_rules": ["OSMF_TILE_HOST"]},
    {"id": "safe-local-collection", "snippet": "const data = await fetch('/api/pois').then(r => r.json());", "expected_rules": []},
